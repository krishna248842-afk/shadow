# ── Shadow configuration ────────────────────────────────────────────────
# Copy to .env.local for local dev, or set these as env vars in your host.

# Absolute path of the SQLite database file. On hosts with a persistent
# disk mount at /var/data, set DATABASE_PATH=/var/data/shadow.db
DATABASE_PATH=./data/shadow.db

# Password that protects your dashboard. REQUIRED when deployed publicly.
# Leave empty only for local use on your own machine.
APP_PASSWORD=

# Public base URL of your deployment, used for OAuth callbacks & webhooks.
# Example: https://shadow-yourname.onrender.com
APP_BASE_URL=http://localhost:3000

# Secret used to verify the WhatsApp webhook handshake you choose in Meta's
# dashboard. Any random string you make up, e.g. shadow-wa-7f3a9b
WHATSAPP_VERIFY_TOKEN=

# Meta App Secret (Meta app → Settings → Basic). When set, Shadow verifies the
# X-Hub-Signature-256 signature on every WhatsApp webhook call.
WHATSAPP_APP_SECRET=

# Required for scheduled posts. The /api/cron/tick endpoint refuses to run
# without it. Any random string; point cron-job.org at
#   https://YOUR_DOMAIN/api/cron/tick?secret=YOUR_CRON_SECRET
CRON_SECRET=

# Secret used to verify Razorpay webhook signatures (from Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=

# ── AI (can also be configured from the Settings screen in the app) ──────
# Any OpenAI-compatible endpoint: OpenAI, DeepSeek, Groq, Gemini, OpenRouter...
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── Social / channel credentials (or paste them in the Connectors screen) ─
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
